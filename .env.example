# Public (browser-safe) — optional until the assessment UI is wired to Supabase Auth.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — required for webhooks, PDF upload, and session APIs (never expose to the client).
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — server-only (Phase 1+ checkout + webhooks).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Stripe — browser (Deep Dive checkout Payment Element on /deep-dive).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Optional — Cal.com booking URL for `/deep-dive/schedule` embed and completion emails.
CAL_COM_BOOKING_URL=
